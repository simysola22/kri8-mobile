# Copy this file to .env.local only for local development.
# NEVER commit .env.local or place server secrets in the mobile app.
# For Replit and EAS, use the environment/secrets manager instead.

# Clerk — use the SAME publishable key as the Kri8 web app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# API — the deployed Kri8 backend
EXPO_PUBLIC_API_BASE_URL=https://kri8-obvh.onrender.com

# Build/runtime label
EXPO_PUBLIC_APP_ENV=development
