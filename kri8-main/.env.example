# Kri8 environment template
#
# Copy the relevant values into Replit Secrets or a local, ignored .env file.
# Never commit real credentials. Never bundle server-only values into web/mobile.

# ── API server ───────────────────────────────────────────────────────────────
# Server-side Clerk values. These must belong to the same Clerk instance as the
# web and mobile publishable keys.
CLERK_PUBLISHABLE_KEY=pk_test_your_server_instance_publishable_key
CLERK_SECRET_KEY=sk_test_your_server_secret_key

# Optional server settings
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGIN=

# ── Web app ───────────────────────────────────────────────────────────────────
# Safe to expose in the browser; must match the API and mobile Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_web_instance_publishable_key
VITE_API_BASE_URL=
# Only set this when the deployed web app requires the API Clerk proxy.
VITE_CLERK_PROXY_URL=

# ── Expo mobile app ──────────────────────────────────────────────────────────
# Safe to bundle in the native client; must match the web Clerk instance.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_mobile_instance_publishable_key
EXPO_PUBLIC_API_BASE_URL=https://kri8-obvh.onrender.com
EXPO_PUBLIC_APP_ENV=development

# ── Non-runtime tooling ──────────────────────────────────────────────────────
# Used only by EAS CLI commands. Store this in Replit Secrets, not in an app
# .env file and never expose it to client code.
# EXPO_TOKEN=

# ── Workspace secret ─────────────────────────────────────────────────────────
# Reserved for server integrations that explicitly use it. Do not add it to
# web or mobile bundles.
# SESSION_SECRET=