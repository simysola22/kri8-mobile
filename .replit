modules = ["nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kri8 Mobile Metro"

[[workflows.workflow]]
name = "Kri8 Mobile Metro"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --dir kri8-main/artifacts/kri8-mobile run start:go -- --localhost --port 8082"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 80

[[ports]]
localPort = 21177
externalPort = 3000
